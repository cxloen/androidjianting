<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <!-- 顶部标题 -->
    <TextView
        android:id="@+id/title_text"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="top"
        android:gravity="center"
        android:text="EchoPress\n按住录音，松手回放"
        android:textColor="#e9eaef"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingTop="20dp" />

    <!-- 关闭按钮（右上角） -->
    <ImageButton
        android:id="@+id/close_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="198dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/close_btn_bg"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:scaleType="centerInside"
        android:contentDescription="关闭" />

    <!-- 电平可视化圆圈 -->
    <View
        android:id="@+id/level_circle"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:background="@drawable/circle_bg"
        android:alpha="0.35" />

    <!-- 大圆按钮（透明触摸层） -->
    <View
        android:id="@+id/big_button"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center" />

    <!-- 状态文字 -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:layout_marginTop="140dp"
        android:gravity="center"
        android:text="准备就绪"
        android:textColor="#9ca0a8"
        android:textSize="18sp" />

    <!-- 统计 -->
    <TextView
        android:id="@+id/stats_text"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="录制:0  播放:0"
        android:textColor="#666670"
        android:textSize="13sp" />

</FrameLayout>
